# Application runtime environment (local, test, production)
APP_ENV=local

# Application origin URL for web browser client and CORS headers
APP_ORIGIN=http://localhost:5173

# Release commit identifier or version string
RELEASE_SHA=local-development

# Full database connection string for application runtime (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://commonsbook:password@127.0.0.1:5432/commonsbook

# Direct internal network URL for communicating with the API service
API_INTERNAL_URL=http://127.0.0.1:8000

# PostgreSQL database name for the local database service
POSTGRES_DB=commonsbook

# PostgreSQL administrative username for the local database service
POSTGRES_USER=commonsbook

# PostgreSQL administrative password (empty in example configuration)
POSTGRES_PASSWORD=

# Application database user password (empty in example configuration)
APP_DB_PASSWORD=

# Primary database connection pool size
DB_POOL_SIZE=10

# Maximum database connection overflow beyond primary pool size
DB_MAX_OVERFLOW=20

# Continuous integration environment flag
CI=

# Path to verification evidence and command log output directory
EVIDENCE_DIR=

# Unique identifier for test execution and isolated resource namespace
TEST_RUN_ID=

# Active test execution profile identifier
TEST_PROFILE=standard

# HS256 JWT signing secret key (minimum 32 bytes)
# JWT_SECRET=

# JWT issuer claim
# JWT_ISSUER=

# JWT audience claim
# JWT_AUDIENCE=

# Access token time-to-live in seconds
# ACCESS_TOKEN_TTL_SECONDS=

# HMAC secret used for rate limit identity hashing (HMAC-SHA256)
# RATE_LIMIT_HMAC_SECRET=
